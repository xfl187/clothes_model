# Compose profile and public listener
CLOTHES_MODEL_SITE_ADDRESS=https://localhost
CLOTHES_MODEL_HTTP_PORT=8080
CLOTHES_MODEL_HTTPS_PORT=8443

# Backend deployment settings
CLOTHES_MODEL_ENVIRONMENT=production
CLOTHES_MODEL_BIND_HOST=0.0.0.0
CLOTHES_MODEL_BIND_PORT=8000
CLOTHES_MODEL_DATABASE_URL=sqlite+aiosqlite:////var/lib/clothes-model/db/clothes-model.db
CLOTHES_MODEL_SQLITE_BUSY_TIMEOUT_MS=5000
CLOTHES_MODEL_STORAGE_ROOT=/var/lib/clothes-model/storage
CLOTHES_MODEL_LOG_LEVEL=INFO
CLOTHES_MODEL_CORS_ALLOWLIST=[]
CLOTHES_MODEL_SCHEDULER_ENABLED=true
CLOTHES_MODEL_INSTANCE_LOCK_PATH=/var/lib/clothes-model/runtime/instance.lock
CLOTHES_MODEL_ENCRYPTION_MASTER_KEY_FILE=/run/secrets/encryption_master_key
CLOTHES_MODEL_ADMIN_SESSION_COOKIE_SECURE=true
CLOTHES_MODEL_WEB_STATIC_ROOT=/app/web

# Required by the production Compose profile. Supply this from the host
# environment or another Compose secret provider; never commit a real value.
CLOTHES_MODEL_ENCRYPTION_MASTER_KEY=replace-at-deploy-time

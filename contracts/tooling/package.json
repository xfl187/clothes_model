{
  "name": "@clothes-model/contract-tooling",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "lint": "redocly lint ../openapi/openapi.yaml --config redocly.yaml",
    "bundle": "redocly bundle ../openapi/openapi.yaml --config redocly.yaml --output ../generated/openapi.yaml",
    "typecheck:web-generated": "tsc --project tsconfig.web-generated.json"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@redocly/cli": "2.54.2",
    "@stoplight/prism-cli": "5.16.0",
    "typescript": "7.0.2"
  }
}

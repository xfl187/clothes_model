{
  "name": "clothes-model",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "web:dev": "corepack pnpm@10.34.5 --filter @clothes-model/web-admin dev",
    "web:lint": "corepack pnpm@10.34.5 --filter @clothes-model/web-admin lint",
    "web:typecheck": "corepack pnpm@10.34.5 --filter @clothes-model/web-admin typecheck",
    "web:test": "corepack pnpm@10.34.5 --filter @clothes-model/web-admin test",
    "web:build": "corepack pnpm@10.34.5 --filter @clothes-model/web-admin build",
    "web:test:e2e": "corepack pnpm@10.34.5 --filter @clothes-model/web-admin test:e2e"
  }
}
